.DS_Store
*.swp
*.swo

# Generated / large data
data/
datasets/*
!datasets/README.md
models/*
!models/README.md
predicts/*
!predicts/.gitkeep
*.sac
*.mseed
*.npz
*.npy
*.pt
*.pth
*.ckpt
auto_tracks*.csv
summary.json

# Generated previews / reports
preview.png
preview_abs.png
